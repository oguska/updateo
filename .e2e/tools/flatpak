#!/bin/sh
# Sahte flatpak: sorgular UPDATEO_FAKE_DB'den, kurulum/kaldırma yalnız loglar.
db="${UPDATEO_FAKE_DB:?}"
case "${1:-}" in
  list)
    case "${2:-}" in
      --columns=ref,version) grep '^fpref'  "$db" | sed 's/^fpref\t//' ;;
      --columns=app,runtime) grep '^fprun'  "$db" | sed 's/^fprun\t//' ;;
      --columns=app,version) grep '^fpinst' "$db" | sed 's/^fpinst\t//' ;;
    esac ;;
  remote-ls) grep '^up flatpak' "$db" | sed 's/^up flatpak\t//' ;;
  search)
    q=${2:-}
    [ -n "$q" ] || exit 1
    awk -F'\t' -v q="$q" '$1 == "findfp" &&
      (index(tolower($2), tolower(q)) || index(tolower($3), tolower(q)) ||
       index(tolower($5), tolower(q))) {
        printf "%s\t%s\t%s\t%s\t%s\n", $2, $3, $4, $5, $6
      }' "$db" ;;
  info)
    app=${2:-}
    [ -n "$app" ] || exit 1
    awk -F'\t' -v a="$app" '
      $1 == "fpinst" && $2 == a { installed = 1; local_version = $3 }
      $1 == "findfp" && $2 == a { name = $3; remote_version = $4; desc = $5; found = 1 }
      END {
        if (!installed) exit 1
        if (found) {
          printf "ID: %s\nName: %s\nVersion: %s\nDescription: %s\n", a, name, remote_version, desc
        } else {
          printf "ID: %s\nVersion: %s\n", a, local_version
        }
      }' "$db" ;;
  remote-info)
    remote=${2:-}
    app=${3:-}
    [ -n "$remote" ] && [ -n "$app" ] || exit 1
    awk -F'\t' -v r="$remote" -v a="$app" '$1 == "findfp" && $2 == a && $6 == r {
      printf "Remote: %s\nID: %s\nName: %s\nVersion: %s\nDescription: %s\n", $6, $2, $3, $4, $5
      found = 1
    } END { exit found ? 0 : 1 }' "$db" ;;
  install) shift; echo "FAKE-SUDO: flatpak install $*" >> "${FAKE_SUDO_LOG:?}" ;;
  uninstall) shift; echo "FAKE-SUDO: flatpak uninstall $*" >> "${FAKE_SUDO_LOG:?}" ;;
esac
